PORT=8080
ENV=local   #local/staging/production
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=5434
BLUEPRINT_DB_DATABASE=commonmind
# Local Docker credentials — docker-compose creates this user on first start.
# Use real secrets in staging/production.
BLUEPRINT_DB_USERNAME=commonmind
BLUEPRINT_DB_PASSWORD=commonmind
BLUEPRINT_DB_SCHEMA=public
BLUEPRINT_DB_SSLMODE=disable
# Redis for the job queue and cache — docker-compose starts one on 6380 (omit to disable)
REDIS_URL=redis://localhost:6380
RATE_LIMIT_RPS=100       # requests/sec per IP (omit or 0 = disabled)
RATE_LIMIT_BURST=500     # burst capacity (defaults to RPS×5)
# CORS allowed origins — comma-separated list of allowed web client URLs
# Defaults to http://localhost:3000 if omitted
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Firebase project ID — e.g. my-app-12345 (omit to disable auth)
FIREBASE_PROJECT_ID=
# Service account key as a single-line JSON string. Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=
# Sentry error tracking DSN (optional; leave empty to disable)
SENTRY_DSN=
# WebSocket allowed origin in staging/production — e.g. https://example.com
# Leave empty to deny all cross-origin WebSocket connections in non-debug mode.
BLUEPRINT_WS_ALLOWED_ORIGIN=http://localhost:3000
# Grafana admin credentials (Docker Compose only; defaults to admin/admin locally)
# Override in production via environment variables — never commit real passwords.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Mailjet transactional email (optional; omit or leave empty to disable email sending)
# API keys from: https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Sender identity — must be a verified Mailjet sender address
FROM_EMAIL=
FROM_NAME=CommonMind
# Cloudflare R2 object storage (optional; omit or leave empty to disable file storage)
# Account ID from: Cloudflare Dashboard → R2 → Overview
R2_ACCOUNT_ID=
# API token credentials (create from: Cloudflare Dashboard → R2 → Manage API Tokens)
R2_ACCESS_KEY=
R2_SECRET_KEY=
# The name of your R2 bucket
R2_BUCKET=
# Public URL for the bucket (set up a custom domain or use r2.dev subdomain)
R2_PUBLIC_URL=
