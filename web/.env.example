# Playground inference — the Runpod pod running inference/server.py (see inference/README.md).
# Leave empty to run the site without the Playground; /api/translate then returns 503.
TRANSLATE_API_URL=
# Shared secret the inference server checks in the X-API-Key header.
TRANSLATE_API_KEY=

# Go backend (backend/) — the Data Lab API and its live progress socket.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Optional: the backend's address as the web server reaches it, for the Data Lab
# admin (/data-lab/admin), which reads the backend from the server only. Falls
# back to NEXT_PUBLIC_BACKEND_URL. The admin's password is the backend's
# ADMIN_PASSWORD (backend/.env.example); the web app only passes on what's typed.
BACKEND_URL=

# Optional: where the web app loads published static assets from, such as the
# Data Lab's hand tracker (backend: make publish-mediapipe). The R2 bucket's
# public URL, backend R2_PUBLIC_URL. Defaults to https://cdn.thecommonmind.org.
NEXT_PUBLIC_ASSETS_URL=

# Firebase Auth for Data Lab sign-in — the web app config from
# Firebase Console → Project settings → Your apps. Same project as the backend's
# FIREBASE_PROJECT_ID.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sanity CMS — the site's editorial content, edited in the Studio at /studio.
# See docs/cms.md. Project ID from sanity.io/manage (not a secret: the dataset
# is public, and editing needs a Sanity login).
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name; defaults to production when empty.
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only API token with Editor rights, for the seed script that writes
# content into the dataset (pnpm sanity:seed). From sanity.io/manage → API →
# Tokens; starts with "sk". Never prefix it with NEXT_PUBLIC_.
SANITY_API_TOKEN=
