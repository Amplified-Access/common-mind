# Playground inference — the Runpod pod running inference/server.py (see inference/README.md).
# Leave empty to run the site without the Playground; /api/translate then returns 503.
TRANSLATE_API_URL=
# Shared secret the inference server checks in the X-API-Key header.
TRANSLATE_API_KEY=

# Go backend (backend/) — the Data Lab API and its live progress socket.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Firebase Auth for Data Lab sign-in. Locally these point at the Auth Emulator
# that backend/docker-compose.yml runs; "demo-" projects need no real Firebase
# project, and the API key can be any string. In production, copy the web app
# config from Firebase Console → Project settings, and leave the emulator host empty.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-commonmind.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-commonmind
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
