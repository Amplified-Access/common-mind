# The standalone Data Lab. It shares the main site's backend and Firebase
# project, so volunteers and their work are the same in both. Copy these values
# from web/.env.local, and add this app's origin to the backend's
# CORS_ALLOWED_ORIGINS and BLUEPRINT_WS_ALLOWED_ORIGIN.

# Go backend — the Data Lab API and its live progress socket.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Firebase web app config — the same project as web/ and the backend's
# FIREBASE_PROJECT_ID (Firebase Console → Project settings → Your apps).
# Add this app's domain under Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The main site, for the terms of use volunteers agree to when they join
# (linked as <site>/terms). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
